        <type>void</type>
        <definition>void micro_os_plus_trace_dump_args</definition>
        <argsstring>(int argc, char *argv[])</argsstring>
        <name>micro_os_plus_trace_dump_args</name>
        <param>
          <type>int</type>
          <declname>argc</declname>
        </param>
        <param>
          <type>char *</type>
          <declname>argv</declname>
          <array>[]</array>
